/-!
# Theorems about `{{CRATE}}` (generated by `cargo tauten new`)

Stated over the extracted definitions in `Extracted/{{LEAN_FILE}}.lean`
(namespace `{{CRATE_SNAKE}}`; regenerate with `sh proofs/refresh.sh`). Each
theorem is listed in `proofs/claims.toml` with the Rust function it is
about and the mutants that must break it.

A theorem of the shape `∀ args, f args ⦃ r => … ⦄` with no hypotheses
states that `f` never fails for any input (a `total` theorem).
-/

open Aeneas Aeneas.Std Result
open {{CRATE_SNAKE}}

namespace Proofs.{{MODULE}}

/-- `affordable` never fails, and is true exactly when `spent + cost`
(as a natural number, so without overflow) is within `budget`. -/
theorem affordable_spec (budget spent cost : U64) :
    affordable budget spent cost
      ⦃ r => r = decide (spent.val + cost.val ≤ budget.val) ⦄ := by
  have h := U64.checked_add_bv_spec spent cost
  have hb : budget.val ≤ U64.max := by scalar_tac
  unfold affordable
  cases hc : U64.checked_add spent cost with
  | none =>
    simp_all [lift]
    omega
  | some t =>
    simp_all [lift]

end Proofs.{{MODULE}}
