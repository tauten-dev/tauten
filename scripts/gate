#!/usr/bin/env bash
# The commit gate. Runs inside `docker compose run --rm gate` (read-only
# checkout); also runnable on a host with the pinned toolchain.
set -euo pipefail
cd "$(dirname "$0")/.."
# Recorded with the result: tests that pass only as root are not a pass on
# a developer's host (#42; root is the TAUTEN_GATE_ROOT=1 opt-in).
ran_as="uid=$(id -u) gid=$(id -g)"
echo "gate: running as $ran_as"

# In Docker (TAUTEN_GATE_SNAPSHOT=1) the gate checks the committed HEAD, not
# the live working tree, so a result always describes one commit and
# concurrent edits cannot leak in.
if [[ "${TAUTEN_GATE_SNAPSHOT:-0}" == 1 ]]; then
  snapshot="$(mktemp -d)"
  trap 'rm -rf "$snapshot"' EXIT
  git archive HEAD | tar -x -C "$snapshot"
  printf 'gate: checking commit %s\n' "$(git rev-parse HEAD)"
  cd "$snapshot"
fi

step() { printf '\n== %s\n' "$*"; }

step "format"
cargo fmt --all --check

step "build"
cargo build --locked --workspace --all-targets

step "tests (unit + fixture suite)"
cargo test --locked --workspace

step "self-check: tauten's own profile on tauten"
cargo run --locked --quiet -p cargo-tauten -- tauten check

step "generated files: docs/RULES.md and tauten's shipped claims are current"
cargo run --locked --quiet -p cargo-tauten -- tauten generated --only rules shipped-claims \
  || { echo "docs/RULES.md is stale: run 'cargo run -p cargo-tauten -- tauten explain --markdown > docs/RULES.md'"; exit 1; }

step "benchmark tasks: admission criteria (reference/null/sloppy agents)"
scripts/bench-validate

step "scanner mutation gate: every mutant of the fact extraction is killed (T7)"
# The proved kernel decides; these scanners produce its facts. Zero
# surviving mutants; equivalent ones are listed with reasons in
# .cargo/mutants.toml.
scripts/mutants --file crates/tauten-check/src/scan.rs \
  --file crates/tauten-check/src/effects.rs \
  --file crates/tauten-check/src/manifest.rs \
  --jobs "${TAUTEN_MUTANT_JOBS:-4}" --timeout 180

step "dependencies: licenses, advisories, sources"
cargo deny --locked check

printf '\ngate: passed (as %s)\n' "$ran_as"
