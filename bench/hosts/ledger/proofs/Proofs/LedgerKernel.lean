import Extracted.LedgerKernel

/-!
# Theorems about `ledger-kernel` (generated by `cargo tauten init --proofs`)

The worked example of tauten's proof tier: one theorem about
`ledger_kernel::apply`, over its Charon/Aeneas translation in
`Extracted/LedgerKernel.lean`. Listed in `proofs/claims.toml` with two
mutants that must break it.

A theorem of the shape `∀ args, f args ⦃ r => … ⦄` with no hypotheses states
that `f` never fails for any input; the audit reports it as total.
-/

open Aeneas Aeneas.Std Result
open ledger_kernel

namespace Proofs.LedgerKernel

/-- What `apply` returns, for every balance and entry (so it never panics or
overflows): a deposit is the exact sum when it fits in a `u64` and
`Overflow` otherwise; a withdrawal is the exact difference when it does not
exceed the balance and `Insufficient` otherwise. -/
theorem apply_spec (balance : U64) (entry : Entry) :
    apply balance entry ⦃ r => match entry with
      | .Deposit amount =>
        if balance.val + amount.val ≤ U64.max then
          ∃ after, r = .Ok after ∧ after.val = balance.val + amount.val
        else r = .Err .Overflow
      | .Withdraw amount =>
        if amount.val ≤ balance.val then
          ∃ after, r = .Ok after ∧ after.val = balance.val - amount.val
        else r = .Err .Insufficient ⦄ := by
  cases entry with
  | Deposit amount =>
    have h := U64.checked_add_bv_spec balance amount
    unfold apply
    cases hc : U64.checked_add balance amount with
    | none =>
      simp only [hc] at h
      have : ¬ balance.val + amount.val ≤ U64.max := by omega
      simp [lift, this, hc]
    | some after =>
      simp only [hc] at h
      have : balance.val + amount.val ≤ U64.max := h.1
      simp [lift, this, hc, h.2.1]
  | Withdraw amount =>
    have h := U64.checked_sub_bv_spec balance amount
    unfold apply
    cases hc : U64.checked_sub balance amount with
    | none =>
      simp only [hc] at h
      have : ¬ amount.val ≤ balance.val := by omega
      simp [lift, this, hc]
    | some after =>
      simp only [hc] at h
      have : amount.val ≤ balance.val := h.1
      simp [lift, this, hc, h.2.1]

end Proofs.LedgerKernel
