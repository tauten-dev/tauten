def tiers.rank (of : tiers.Tier) : Result Std.U8 := do
  match of with
  | tiers.Tier.Kernel => ok 0#u8
  | tiers.Tier.Core => ok 1#u8
  | tiers.Tier.Edge => ok 2#u8

/-- [tauten_check_kernel::tiers::may_depend_on]:
    Source: 'crates/tauten-check-kernel/src/tiers.rs', lines 28:0-30:1
    Visibility: public -/
def tiers.may_depend_on
  (of : tiers.Tier) (dep : tiers.Tier) : Result Bool := do
  let i ← tiers.rank dep
  let i1 ← tiers.rank of
  ok (i <= i1)

