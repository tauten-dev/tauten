  := do
  let o ←
    core.slice.Slice.get (core.slice.index.SliceIndexUsizeSlice (Std.U32 ×
      Std.U32)) spans i
  match o with
  | none => ok best
  | some candidate =>
    let b ← span.covers candidate line
