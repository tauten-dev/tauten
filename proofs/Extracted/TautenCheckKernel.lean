    Visibility: public -/
def exception.excuse
  (rule_allows : Bool) (tier : tiers.Tier) (level : Option severity.Level)
  (crate_wide : Bool) :
  Result exception.Excuse
  := do
  let b ← exception.permitted rule_allows tier level
  if b
  then
    let blocking ←
      match level with
      | none => ok false
      | some given => severity.is_blocking given
    if crate_wide
    then
      if blocking
      then ok exception.Excuse.CrateWide
      else ok exception.Excuse.Allowed
    else ok exception.Excuse.Allowed
  else ok exception.Excuse.Forbidden

