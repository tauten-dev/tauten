    then
      match best with
      | none => ok (some i)
      | some b1 =>
        let o1 ←
          core.slice.Slice.get (core.slice.index.SliceIndexUsizeSlice (Std.U32
            × Std.U32)) spans b1
        match o1 with
        | none => ok (some i)
        | some current =>
          let i1 ← span.width current
          let i2 ← span.width candidate
          if i1 <= i2
          then ok best
          else ok (some i)
    else ok best

