  := do
  let kind ←
    match finding with
    | subsume.Finding.Arithmetic => ok true
    | subsume.Finding.Indexing => ok true
    | subsume.Finding.Other => ok false
  let kernel ←
    match tier with
    | tiers.Tier.Kernel => ok true
    | tiers.Tier.Core => ok false
    | tiers.Tier.Edge => ok false
  if kernel
