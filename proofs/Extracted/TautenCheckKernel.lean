    else ok (declared4, false)
  let (declared6, b5) ←
    if derived.fail
    then ok (declared5, ¬ declared5.fail)
    else ok (declared5, false)
  if derived.suspend
  then
    ok
      {
        clock := b,
        env := b1,
        fs_read := b2,
        fs_write := b3,
        net := b4,
